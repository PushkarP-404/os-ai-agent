#!/sbin/openrc-run
# /etc/init.d/ai-agent — OpenRC service for the Elenchus kernel daemon
# Install: cp this file to /etc/init.d/ai-agent && chmod +x /etc/init.d/ai-agent
#          rc-update add ai-agent default

description="Elenchus kernel-userspace agent daemon"

# Phase 6: paths normalized to system locations (/usr/local)
AGENT_SCRIPT="${AGENT_SCRIPT:-/usr/local/lib/ai-agent/agent_daemon.py}"
PYTHON_BIN="${PYTHON_BIN:-/usr/bin/python3}"
AGENT_LOG="/var/log/ai-agent.log"
AGENT_PIDFILE="/run/ai-agent.pid"

# LLM backend — native musl llama-server (Phase 5/6).
export LLAMA_URL="${LLAMA_URL:-http://127.0.0.1:11434/completion}"
export AI_AGENT_LOG_DIR="${AI_AGENT_LOG_DIR:-/var/ai-agent}"
# V2 is the standard task harness. Set to 0 only for a temporary rollback.
export HARNESS_V2="${HARNESS_V2:-1}"

depend() {
    need localmount
    need ai-agent-privileged
    # Depend on llama-server for in-guest LLM inference
    use llama-server
    after llama-server
}

start_pre() {
    if [ ! -f "$AGENT_SCRIPT" ]; then
        eerror "agent_daemon.py not found at $AGENT_SCRIPT"
        return 1
    fi
    # Verify we are running on the custom ai-agent kernel
    KERNEL=$(uname -r)
    case "$KERNEL" in
        *-ai-agent*)
            einfo "Custom kernel detected: $KERNEL"
            ;;
        *)
            ewarn "WARNING: Not running on ai-agent kernel ($KERNEL)."
            ewarn "Netlink socket may fail. Boot 6.6.142-ai-agent and retry."
            ;;
    esac
    mkdir -p /var/ai-agent/logs /var/ai-agent/training_data /var/ai-agent/tasks
    chown -R ai-agent:ai-agent /var/ai-agent
    touch "$AGENT_LOG"
    chown ai-agent:ai-agent "$AGENT_LOG"
    # Phase 11: task_runner subprocess log
    touch /var/log/task_runner.log
    chmod 666 /var/log/task_runner.log
}

start() {
    ebegin "Starting Elenchus kernel daemon"
    start-stop-daemon --start \
        --background \
        --make-pidfile \
        --pidfile "$AGENT_PIDFILE" \
        --user ai-agent:ai-agent \
        --stdout "$AGENT_LOG" \
        --stderr "$AGENT_LOG" \
        --exec "$PYTHON_BIN" \
        -- "$AGENT_SCRIPT"
    local ret=$?
    # Give the daemon 2 seconds to register with the kernel before returning
    sleep 2
    eend $ret
}

stop() {
    ebegin "Stopping Elenchus kernel daemon"
    start-stop-daemon --stop \
        --pidfile "$AGENT_PIDFILE" \
        --retry "SIGTERM/10/SIGKILL/5"
    eend $?
}

status() {
    if [ -f "$AGENT_PIDFILE" ] && kill -0 "$(cat $AGENT_PIDFILE)" 2>/dev/null; then
        einfo "ai-agent is running (PID $(cat $AGENT_PIDFILE))"
        return 0
    else
        einfo "ai-agent is not running"
        return 1
    fi
}
