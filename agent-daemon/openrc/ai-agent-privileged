#!/sbin/openrc-run
# Root-owned local broker for the narrow V2 harness tool set.

description="Elenchus privileged harness broker"

BROKER_SCRIPT="${BROKER_SCRIPT:-/usr/lib/ai-agent/harness_privileged.py}"
PYTHON_BIN="${PYTHON_BIN:-/usr/bin/python3}"
BROKER_PIDFILE="/run/ai-agent-privileged.pid"
BROKER_LOG="/var/log/ai-agent-privileged.log"

depend() {
    need localmount
    before ai-agent
}

start_pre() {
    [ -f "$BROKER_SCRIPT" ] || { eerror "Broker script not found: $BROKER_SCRIPT"; return 1; }
    mkdir -p /run/ai-agent
    touch "$BROKER_LOG"
    chmod 600 "$BROKER_LOG"
}

start() {
    ebegin "Starting Elenchus privileged harness broker"
    start-stop-daemon --start --background --make-pidfile --pidfile "$BROKER_PIDFILE" \
        --stdout "$BROKER_LOG" --stderr "$BROKER_LOG" --exec "$PYTHON_BIN" -- "$BROKER_SCRIPT"
    eend $?
}

stop() {
    ebegin "Stopping Elenchus privileged harness broker"
    start-stop-daemon --stop --pidfile "$BROKER_PIDFILE" --retry "SIGTERM/10/SIGKILL/5"
    eend $?
}
