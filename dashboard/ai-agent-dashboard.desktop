[Desktop Entry]
Version=1.0
Type=Application
Name=Sentinel Control Center
GenericName=Elenchus Control Center
Comment=Elenchus Flagship Control Center & Autonomous AI Assistant
Exec=/usr/bin/ai-agent-dashboard
Icon=elenchus
Terminal=false
StartupNotify=true
Categories=System;Settings;Utility;
Keywords=Elenchus;AI;Agent;Sentinel;LLM;Syscall;Telemetry;
Actions=NewPrompt;

[Desktop Action NewPrompt]
Name=Open Interactive Prompt
Exec=/usr/bin/ai-agent-dashboard --prompt
