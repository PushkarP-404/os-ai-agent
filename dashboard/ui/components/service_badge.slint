// ============================================================
// ServiceBadge — RUNNING / STOPPED / CHECKING status pill
// ============================================================
import { Theme } from "../theme.slint";

export enum ServiceStatus { Running, Stopped, Checking }

export component ServiceBadge {
    in property <string>        label:  "";
    in property <ServiceStatus> status: ServiceStatus.Checking;

    property <color> pill-color:
        status == ServiceStatus.Running  ? Theme.ok   :
        status == ServiceStatus.Stopped  ? Theme.err  : Theme.warn;

    property <string> status-text:
        status == ServiceStatus.Running  ? "RUN"  :
        status == ServiceStatus.Stopped  ? "STOP" : "...";

    height: 24px;

    HorizontalLayout {
        spacing: Theme.sp-2;

        // Status dot
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px; height: 7px;
                border-radius: 4px;
                background: pill-color;
                opacity: status == ServiceStatus.Checking ? 0.5 : 1.0;
            }
        }

        Text {
            text: label;
            font-size: Theme.text-xs;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Pill tag
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: status-label-text.preferred-width + 12px;
                border-radius: Theme.radius-pill;
                background: pill-color.with-alpha(0.15);
                border-width: 1px;
                border-color: pill-color.with-alpha(0.4);

                status-label-text := Text {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: status-text;
                    font-size: 9px;
                    font-weight: Theme.weight-bold;
                    color: pill-color;
                    letter-spacing: 0.5px;
                }
            }
        }
    }
}
