// ============================================================
// MetricGauge — circular arc gauge for CPU / RAM / Disk
// ============================================================
import { Theme } from "../theme.slint";

export component MetricGauge {
    in property <float>  value:   0.0;   // 0.0 – 1.0
    in property <string> label:   "";
    in property <string> unit:    "%";
    in property <color>  color-low:  Theme.ok;
    in property <color>  color-high: Theme.err;

    property <float> clamped: clamp(root.value, 0.0, 0.999);

    // Derived: colour shifts from green -> amber -> red
    property <color> gauge-color: value < 0.6
        ? Theme.ok
        : value < 0.85 ? Theme.warn : Theme.err;

    width: 80px;
    height: 92px;

    VerticalLayout {
        alignment: center;
        spacing: Theme.sp-1;

        Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.glass-border;

            // Track ring
            Rectangle {
                x: 6px; y: 6px;
                width: 60px; height: 60px;
                border-radius: 30px;
                border-width: 5px;
                border-color: Theme.border;
                background: transparent;
            }

            // Proportional SVG arc from 12 o'clock clockwise
            if clamped > 0.005 : Path {
                x: 6px; y: 6px;
                width: 60px; height: 60px;
                stroke: gauge-color;
                stroke-width: 5px;
                fill: transparent;
                viewbox-width: 100;
                viewbox-height: 100;

                MoveTo { x: 50; y: 8; }
                ArcTo {
                    radius-x: 42;
                    radius-y: 42;
                    x: 50 + 42 * Math.sin(clamped * 360deg);
                    y: 50 - 42 * Math.cos(clamped * 360deg);
                    sweep: true;
                    large-arc: clamped >= 0.5;
                }
            }

            // Centre percentage label
            Text {
                x: 0; y: 0;
                width: 72px;
                height: 72px;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: Math.round(root.value * 100) + unit;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-bold;
                color: gauge-color;
            }
        }

        Text {
            horizontal-alignment: center;
            text: label;
            font-size: Theme.text-xs;
            color: Theme.text-muted;
        }
    }
}
