#!/bin/sh
addgroup -S ai-agent 2>/dev/null || true
adduser -S -G ai-agent -H -h /var/ai-agent ai-agent 2>/dev/null || true

# Clean legacy unowned regular files in /usr/local/lib/ai-agent so symlinks extract cleanly
for f in /usr/local/lib/ai-agent/*.py /usr/local/lib/ai-agent/*.gbnf; do
    if [ -f "$f" ] && [ ! -L "$f" ]; then
        rm -f "$f" 2>/dev/null || true
    fi
done
exit 0

