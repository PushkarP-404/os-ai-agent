xft-rgba=rgb
indicators=~host;~spacer;~clock;~spacer;~session;~power
EOF

    cat << 'EOF' > "$pkgdir/usr/share/ai-agent/themes/50-autologin.conf"
[Seat:*]
autologin-user=aiuser
autologin-user-timeout=0
autologin-session=xfce
user-session=xfce
greeter-session=lightdm-gtk-greeter
display-setup-script=/usr/local/bin/agent-display-setup.sh
session-setup-script=/usr/local/bin/agent-display-setup.sh
EOF

    install -d "$pkgdir/usr/local/bin"
    cat << 'EOF' > "$pkgdir/usr/local/bin/agent-display-setup.sh"
#!/bin/sh
chvt 7 2>/dev/null || true
EOF
    chmod +x "$pkgdir/usr/local/bin/agent-display-setup.sh"

    cat << 'EOF' > "$pkgdir/usr/share/ai-agent/themes/xsettings.xml"
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Adwaita"/>
