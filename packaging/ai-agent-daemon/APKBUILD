    # ── Presets for LightDM Greeter & XFCE4 Settings ───────────────────
    install -d "$pkgdir/usr/share/ai-agent/themes"
    cat << 'EOF' > "$pkgdir/usr/share/ai-agent/themes/lightdm-gtk-greeter.conf"
[greeter]
background=/usr/share/backgrounds/agent-os-wallpaper.jpg
theme-name=Adwaita
icon-theme-name=Papirus-Dark
font-name=Noto Sans 10
xft-antialias=true
xft-dpi=96
