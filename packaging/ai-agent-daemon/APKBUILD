    cp "$pkgdir/etc/xdg/gtk-3.0/settings.ini" "$pkgdir/etc/skel/.config/gtk-3.0/settings.ini"

    # ── Modern Monospace Dark Terminal Configuration ───────────────────
    install -d "$pkgdir/etc/skel/.config/xfce4/terminal"
